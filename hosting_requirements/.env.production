# ===========================================
# Asset Tracker - Production Environment Configuration
# ===========================================
#
# IMPORTANT: Copy this file to .env in the application root
# Update all values with your actual production settings
# Never commit .env file to version control
#

# ===========================================
# Django Core Settings
# ===========================================

# Secret Key (CRITICAL: Generate a new one for production)
# Generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_HERE_CHANGE_THIS

# Debug Mode (MUST be False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of domains/IPs)
# Examples: yourdomain.com,www.yourdomain.com,192.168.1.100
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip,assettracker.yourdomain.com


# ===========================================
# Database Configuration
# ===========================================

# Database Engine Options:
# - django.db.backends.sqlite3 (Development only)
# - django.db.backends.postgresql (Recommended for production)
# - django.db.backends.mysql
# - sql_server.pyodbc (SQL Server)

# For PostgreSQL (Recommended):
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=asset_tracker
DATABASE_USER=asset_tracker_user
DATABASE_PASSWORD=YourSecureDatabasePassword123!
DATABASE_HOST=localhost
DATABASE_PORT=5432

# For SQLite (Not recommended for production):
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# For SQL Server:
# DATABASE_ENGINE=sql_server.pyodbc
# DATABASE_NAME=asset_tracker
# DATABASE_USER=sa
# DATABASE_PASSWORD=YourPassword
# DATABASE_HOST=localhost
# DATABASE_PORT=1433


# ===========================================
# Security Settings
# ===========================================

# SSL/HTTPS Settings (Enable after SSL certificate is installed)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security) - Enable after HTTPS is working
SECURE_HSTS_SECONDS=0

# Session Settings
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False


# ===========================================
# Email Configuration
# ===========================================

# Email Backend Options:
# - django.core.mail.backends.smtp.EmailBackend (Production)
# - django.core.mail.backends.console.EmailBackend (Development)

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Asset Tracker <noreply@yourdomain.com>

# For Microsoft Exchange/Office365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@yourdomain.com
# EMAIL_HOST_PASSWORD=your-password

# Password Reset Timeout (in seconds, default: 1 hour)
PASSWORD_RESET_TIMEOUT=3600


# ===========================================
# Celery Configuration (Task Queue)
# ===========================================

# Redis URL for Celery broker and results backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ===========================================
# Power Monitoring Settings
# ===========================================

# Default email for power monitoring notifications
DEFAULT_NOTIFICATION_RECIPIENT=admin@yourdomain.com

# Enable/Disable power monitoring
POWER_MONITORING_ENABLED=True


# ===========================================
# Static and Media Files
# ===========================================

# These are typically handled by web server
# STATIC_URL=/static/
# STATIC_ROOT=C:\inetpub\wwwroot\AssetTracker\staticfiles
# MEDIA_URL=/media/
# MEDIA_ROOT=C:\inetpub\wwwroot\AssetTracker\media


# ===========================================
# Logging Configuration
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ===========================================
# Optional: External Services
# ===========================================

# Add any third-party service API keys here
# EXAMPLE_API_KEY=your_api_key_here


# ===========================================
# Notes:
# ===========================================
#
# 1. After copying this file to .env, update ALL values marked with YOUR_*
# 2. Generate a new SECRET_KEY for production
# 3. Set DEBUG=False in production
# 4. Configure your actual domain names in ALLOWED_HOSTS
# 5. Use PostgreSQL or SQL Server for production database
# 6. Configure email settings for notifications
# 7. Enable HTTPS settings after SSL certificate is installed
# 8. Keep this file secure and never commit to version control
#
