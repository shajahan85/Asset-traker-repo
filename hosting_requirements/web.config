<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- FastCGI Handler Configuration -->
    <handlers>
      <add name="Django Handler" 
           path="*" 
           verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="C:\inetpub\wwwroot\AssetTracker\venv\Scripts\python.exe|C:\inetpub\wwwroot\AssetTracker\venv\Lib\site-packages\wfastcgi.py" 
           resourceType="Unspecified" 
           requireAccess="Script" />
    </handlers>
    
    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>
        <!-- Redirect to HTTPS (uncomment after SSL is configured) -->
        <!--
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->
        
        <!-- Static Files Rule -->
        <rule name="Static Files" stopProcessing="true">
          <match url="^(static|media)/(.*)$" />
          <action type="Rewrite" url="{R:1}/{R:2}" />
        </rule>
        
        <!-- Django Handler Rule -->
        <rule name="Django Application" stopProcessing="true">
          <match url="(.*)" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- Static Content Configuration -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    
    <!-- Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Uncomment after HTTPS is configured -->
        <!--<add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />-->
      </customHeaders>
    </httpProtocol>
    
    <!-- Directory Browsing -->
    <directoryBrowse enabled="false" />
    
    <!-- Default Document -->
    <defaultDocument enabled="false" />
    
    <!-- HTTP Errors -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    
    <!-- Request Filtering -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
        <!-- Max upload size: 100 MB -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="__pycache__" />
          <add segment="venv" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    
  </system.webServer>
  
  <!-- FastCGI Application Configuration -->
  <system.webServer>
    <fastCgi>
      <application fullPath="C:\inetpub\wwwroot\AssetTracker\venv\Scripts\python.exe" 
                   arguments="C:\inetpub\wwwroot\AssetTracker\venv\Lib\site-packages\wfastcgi.py" 
                   maxInstances="4"
                   idleTimeout="1800"
                   activityTimeout="1800"
                   requestTimeout="1800"
                   instanceMaxRequests="10000"
                   protocol="NamedPipe"
                   flushNamedPipe="False">
        
        <!-- Environment Variables -->
        <environmentVariables>
          <environmentVariable name="DJANGO_SETTINGS_MODULE" value="asset_tracker.settings" />
          <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\AssetTracker" />
          <environmentVariable name="WSGI_HANDLER" value="asset_tracker.wsgi.application" />
          <environmentVariable name="WSGI_LOG" value="C:\inetpub\wwwroot\AssetTracker\logs\wfastcgi.log" />
          <environmentVariable name="WSGI_RESTART_FILE_REGEX" value=".*((\.py)|(\.config))$" />
        </environmentVariables>
      </application>
    </fastCgi>
  </system.webServer>
  
  <!-- App Settings -->
  <appSettings>
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\AssetTracker" />
    <add key="DJANGO_SETTINGS_MODULE" value="asset_tracker.settings" />
    <add key="WSGI_HANDLER" value="asset_tracker.wsgi.application" />
  </appSettings>
  
</configuration>
