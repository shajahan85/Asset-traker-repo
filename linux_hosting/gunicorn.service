# Systemd service file for Asset Tracker Gunicorn
# Place this file at: /etc/systemd/system/asset_tracker.service

[Unit]
Description=Asset Tracker Gunicorn daemon
Requires=asset_tracker.socket
After=network.target

[Service]
Type=notify
# the specific user that our service will run as
User=www-data
Group=www-data
# another option for an even more restricted service is
# DynamicUser=yes
# see http://0pointer.net/blog/dynamic-users-with-systemd.html
RuntimeDirectory=asset_tracker
WorkingDirectory=/var/www/asset_tracker
ExecStart=/var/www/asset_tracker/venv/bin/gunicorn \
          --config /var/www/asset_tracker/linux_hosting/gunicorn_config.py \
          asset_tracker.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
