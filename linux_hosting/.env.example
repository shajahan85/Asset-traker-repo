# Environment variables for Asset Tracker production deployment
# Copy this file to .env and fill in your actual values

# Django settings
SECRET_KEY=your-very-long-and-random-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=your_domain.com,www.your_domain.com,your_server_ip

# Database settings
DB_ENGINE=postgresql  # or mysql
DB_NAME=asset_tracker_db
DB_USER=asset_tracker_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=5432  # 5432 for PostgreSQL, 3306 for MySQL

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Asset Tracker <noreply@yourdomain.com>

# Optional: Redis cache
REDIS_URL=redis://127.0.0.1:6379/1

# Optional: Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here
