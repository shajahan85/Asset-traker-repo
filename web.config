<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- Handler Mapping for Django -->
    <handlers>
      <add name="Python FastCGI" 
           path="*" 
           verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="D:\Asset tracker\venv\Scripts\python.exe|D:\Asset tracker\venv\Lib\site-packages\wfastcgi.py" 
           resourceType="Unspecified" 
           requireAccess="Script" />
    </handlers>
    
    <!-- Show Detailed Errors (disable in production) -->
    <httpErrors errorMode="Detailed" />
    
  </system.webServer>
</configuration>
